# ─── Google Cloud ────────────────────────────────────────────────────────────
GCP_PROJECT_ID=my-gcp-project
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ─── Vertex AI / Gemini ──────────────────────────────────────────────────────
# Supervisor (Owner-facing): Gemini 2.5 Pro via Vertex AI (us-south1)
# Companion / Customer Agent (Employee-facing): Gemini 2.5 Flash via Vertex AI
GEMINI_MODEL=gemini-2.5-flash
VERTEX_LOCATION=us-central1

# ─── Feature flags ───────────────────────────────────────────────────────────
USE_ADK=true
# Set to true to route chat through Vertex AI Agent Engine (default: Cloud Run TS path)
USE_AGENT_ENGINE=false
# Set to true to enable Vertex AI Search grounding per-tenant datastores
USE_VERTEX_SEARCH=false

# Agent Engine resource name (required when USE_AGENT_ENGINE=true)
# Format: projects/<project>/locations/us-central1/reasoningEngines/<id>
AGENT_ENGINE_RESOURCE_NAME=

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Web client ID reused by Capacitor native Google Sign-In (idToken audience verification).
# Same value as GOOGLE_CLIENT_ID — kept separate for Secret Manager mapping.
GOOGLE_WEB_CLIENT_ID=

# ─── A2A agent-to-agent security ─────────────────────────────────────────────
# HMAC-SHA256 master secret — per-tenant keys derived from this via HMAC(secret, "v1:"+businessId)
A2A_SECRET=

# ─── WhatsApp (optional) ─────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ─── Cron security ───────────────────────────────────────────────────────────
CRON_SECRET=
