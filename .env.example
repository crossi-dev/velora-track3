# Google Vertex AI — primary AI model (Gemini 2.0 Flash)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GEMINI_MODEL=gemini-2.0-flash-001

# Anthropic — Haiku fallback used if Gemini is unavailable
ANTHROPIC_API_KEY= # Haiku fallback — used if Gemini is unavailable

# Database
DATABASE_URL=

# NextAuth
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Web client ID reused by Capacitor native Google Sign-In (idToken audience verification).
# Same value as GOOGLE_CLIENT_ID — kept separate for explicitness and Secret Manager mapping.
GOOGLE_WEB_CLIENT_ID=

# WhatsApp (optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Cron security
CRON_SECRET=
