{
  "name": "velora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rimraf .next/dev/lock && next dev --hostname 0.0.0.0",
    "check:prisma-provider": "node scripts/check-prisma-provider.mjs",
    "build": "npm run check:prisma-provider && npm run check:guardrails && prisma generate && next build",
    "start": "next start",
    "check:action-contract": "node scripts/check-action-contract.mjs",
    "check:contract-drift": "node scripts/check-contract-drift.mjs",
    "check:server-mutation-contract": "node scripts/check-server-mutation-contract.mjs",
    "check:action-paths": "node scripts/enforce-action-node.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:saleitem-immutable": "node scripts/check-saleitem-immutable.mjs",
    "check:api-standards": "node scripts/check-api-standards.mjs",
    "check:domain-imports": "node scripts/check-domain-imports.mjs",
    "check:scheduler": "node scripts/check-scheduler-drift.mjs",
    "lint": "eslint src/",
    "build:widget": "node scripts/build-widget.mjs",
    "preview:widget": "node scripts/build-widget-preview.mjs",
    "typecheck": "tsc --noEmit",
    "check:guardrails": "npm run check:action-contract && npm run check:contract-drift && npm run check:server-mutation-contract && npm run check:action-paths && npm run check:file-size && npm run check:saleitem-immutable && node scripts/check-architectural-invariants.mjs && node scripts/check-tenant-scope.mjs",
    "ci": "npm run lint && npm run typecheck && npm run check:guardrails",
    "eval:intents": "node scripts/happy-paths-100.mjs",
    "eval:adk": "adk eval src/lib/adk/supervisor-agent.ts tests/adk-eval/owner-intents.evalset.json tests/adk-eval/customer-companion.evalset.json --print_detailed_results",
    "eval:judge": "node scripts/eval-llm-judge.mjs",
    "eval:judge:adversarial": "node scripts/eval-llm-judge.mjs --adversarial-only",
    "test:vitest": "vitest run",
    "test:unit": "node --require ./tests/phase4/register.cjs ./tests/unit/run-all.cjs",
    "test:phase4": "node --require ./tests/phase4/register.cjs --test --test-isolation=none tests/phase4/critical-flow-idempotency.test.cjs tests/phase4/push-subscriptions.test.cjs tests/phase4/daily-summary-push.test.cjs tests/phase4/daily-summary-chat.test.cjs tests/phase4/payment-intent-flow.test.cjs tests/phase4/mp-oauth-flow.test.cjs tests/phase4/confirmation-fast-path.test.cjs tests/phase4/payment-link-flow.test.cjs",
    "test": "npm run test:unit && npm run test:phase4",
    "test:e2e": "playwright test",
    "test:smoke:adversarial": "AUTH_SECRET=$AUTH_SECRET node scripts/smoke-adversarial.mjs",
    "test:smoke:cross-role": "AUTH_SECRET=$AUTH_SECRET DATABASE_URL=$DATABASE_URL node scripts/smoke-cross-role.mjs",
    "smoke:full": "node scripts/smoke-orchestrator.mjs --runs 3",
    "db:reset": "node scripts/db-reset.mjs",
    "env:sync": "node scripts/sync-env-from-secrets.mjs",
    "postinstall": "patch-package || true && node scripts/patch-capacitor-plugins.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings 0"
    ]
  },
  "dependencies": {
    "@ar-agents/identity": "^0.5.1",
    "@auth/prisma-adapter": "^2.11.1",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.3.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.4",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@formatjs/intl-localematcher": "^0.8.9",
    "@google-cloud/profiler": "^6.0.4",
    "@google-cloud/pubsub": "^5.3.0",
    "@google-cloud/secret-manager": "^6.1.2",
    "@google-cloud/storage": "^7.19.0",
    "@google-cloud/tasks": "^6.2.2",
    "@google/adk": "^1.1.0",
    "@google/genai": "^2.6.0",
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-virtual": "^3.13.23",
    "chrono-node": "^2.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "exceljs": "^4.4.0",
    "firebase-admin": "^14.0.0",
    "google-auth-library": "^10.6.2",
    "jose": "^6.2.3",
    "libphonenumber-js": "^1.13.6",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.0",
    "mercadopago": "^3.0.0",
    "negotiator": "^1.0.0",
    "next": "^16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "node-forge": "^1.4.0",
    "opossum": "^9.0.0",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "stopword": "^3.1.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "twilio": "^6.0.2",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@eslint/js": "^10.0.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@playwright/test": "^1.60.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/jest": "^30.0.0",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^20",
    "@types/node-forge": "^1.3.14",
    "@types/opossum": "^8.1.9",
    "@types/pdfkit": "^0.17.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^16.4.0",
    "patch-package": "^8.0.1",
    "prisma": "^6.19.3",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.7"
  }
}
