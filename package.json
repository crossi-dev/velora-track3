{
  "name": "velora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rimraf .next/dev/lock && next dev --hostname 0.0.0.0",
    "build": "prisma generate && node scripts/build-widget.mjs && next build",
    "build:widget": "node scripts/build-widget.mjs",
    "start": "next start",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test:vitest": "vitest run",
    "test:unit": "node --require ./tests/phase4/register.cjs ./tests/unit/run-all.cjs",
    "test:phase4": "node --require ./tests/phase4/register.cjs --test --test-isolation=none tests/phase4/critical-flow-idempotency.test.cjs tests/phase4/push-subscriptions.test.cjs tests/phase4/daily-summary-push.test.cjs tests/phase4/daily-summary-chat.test.cjs tests/phase4/payment-intent-flow.test.cjs tests/phase4/mp-oauth-flow.test.cjs tests/phase4/confirmation-fast-path.test.cjs tests/phase4/payment-link-flow.test.cjs",
    "test": "npm run test:unit && npm run test:phase4",
    "test:e2e": "playwright test",
    "postinstall": "patch-package || true",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings 0"
    ]
  },
  "dependencies": {
